{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "main": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/main",
      "sourceRoot": "projects/main/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/main/src/main.ts",
            "tsConfig": "projects/main/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/main/src/assets"
              },
              {
                "glob": "*",
                "input": "i18n",
                "output": "i18n"
              },
              "projects/main/src/.htaccess"
            ],
            "styles": ["projects/main/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "6MB",
                  "maximumError": "6MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "40000kB",
                  "maximumError": "80000kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/library/src/environments/environment.ts",
                  "with": "projects/library/src/environments/environment.prod.ts"
                }
              ]
            },
            "sextant": {
              "fileReplacements": [
                {
                  "replace": "projects/library/src/environments/environment.ts",
                  "with": "projects/library/src/environments/environment.sextant.ts"
                }
              ]
            },
            "sextant-test": {
              "fileReplacements": [
                {
                  "replace": "projects/library/src/environments/environment.ts",
                  "with": "projects/library/src/environments/environment.sextant-test.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "main:build:production"
            },
            "development": {
              "buildTarget": "main:build:development",
              "proxyConfig": "proxy.config.js"
            },
            "e2e": {
              "buildTarget": "main:build:e2e",
              "proxyConfig": "proxy.config.js"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest"
          }
        }
      }
    },
    "gn4-api-client": {
      "projectType": "library",
      "root": "projects/gn4-api-client",
      "sourceRoot": "projects/gn4-api-client/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/gn4-api-client/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/gn4-api-client/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest"
          }
        }
      }
    },
    "gn-api-client": {
      "projectType": "library",
      "root": "projects/gn-api-client",
      "sourceRoot": "projects/gn-api-client/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/gn-api-client/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/gn-api-client/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest"
          }
        }
      }
    },
    "library": {
      "projectType": "library",
      "root": "projects/library",
      "sourceRoot": "projects/library/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/library/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/library/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/library/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
