ARG GEOLIBRE_REF=main

FROM node:22-bookworm-slim AS build
ARG GEOLIBRE_REF
WORKDIR /src

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN git clone --depth=1 --branch "${GEOLIBRE_REF}" https://github.com/opengeos/GeoLibre.git .

RUN npm ci

# Build GeoLibre with a path prefix so all static assets resolve under /geolibre/.
ENV GEOLIBRE_APP_BASE=/geolibre/
RUN npm run build -w geolibre-desktop -- --outDir dist-basepath

FROM ghcr.io/opengeos/geolibre:latest

# Keep upstream entrypoint/sidecar/nginx behavior and only swap frontend assets.
COPY --from=build /src/apps/geolibre-desktop/dist-basepath/ /usr/share/nginx/html/geolibre/

# The upstream template serves /index.html for unknown paths. Add an explicit
# /geolibre route so the base-path build is served from /geolibre/index.html.
RUN python - <<'PY'
from pathlib import Path

template_path = Path('/etc/nginx/nginx.conf.template')
template = template_path.read_text()
anchor = "    location / {\n"
insertion = """    location = /geolibre {
    absolute_redirect off;
    return 301 /geolibre/;
  }

  location ^~ /geolibre/ {
    try_files $uri $uri/ /geolibre/index.html;
    add_header Cache-Control \"no-cache, must-revalidate\" always;
    add_header X-Content-Type-Options \"nosniff\" always;
    add_header Referrer-Policy \"strict-origin-when-cross-origin\" always;
  }

"""

if insertion.strip() not in template:
  if anchor not in template:
    raise RuntimeError('Unable to locate default location block in nginx.conf.template')
  template = template.replace(anchor, insertion + anchor, 1)
  template_path.write_text(template)
PY

# Runtime config is generated by the upstream entrypoint at /geolibre-runtime-config.js.
# Expose the same file under /geolibre/ for base-path builds.
RUN ln -sf ../geolibre-runtime-config.js /usr/share/nginx/html/geolibre/geolibre-runtime-config.js
