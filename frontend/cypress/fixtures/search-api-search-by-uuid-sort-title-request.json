{
  "from": 0,
  "size": 20,
  "track_total_hits": true,
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "cf5048f6\\-5bbf\\-4e44\\-ba74\\-e6f429af51ea",
            "default_operator": "AND",
            "fields": ["resourceTitleObject.*^5", "any.*", "uuid"]
          }
        }
      ],
      "must_not": [],
      "should": [],
      "filter": [
        {
          "query_string": {
            "query": "+isTemplate:n"
          }
        }
      ]
    }
  },
  "_source": [
    "cl_status*",
    "dateStamp",
    "documentStandard",
    "draft",
    "draftId",
    "geom",
    "groupOwner",
    "id",
    "isHarvested",
    "isTemplate",
    "mdStatus*",
    "owner",
    "resourceTitle*",
    "resourceType",
    "status*",
    "uuid",
    "valid",
    "link",
    "rating",
    "resourceAbstract*",
    "resourceCreditObject",
    "logo",
    "overview"
  ],
  "sort": [
    {
      "resourceTitleObject.default.sort": "asc"
    }
  ],
  "aggregations": {
    "groupPublishedId": {
      "terms": {
        "field": "groupPublishedId",
        "size": 300,
        "include": ".*",
        "exclude": "1"
      },
      "meta": {
        "field": "groupPublishedId",
        "orderByTranslation": true,
        "filterByTranslation": true,
        "displayFilter": true,
        "collapsed": false,
        "caseInsensitiveInclude": true
      }
    },
    "th_sextant-theme_tree.key": {
      "terms": {
        "field": "th_sextant-theme_tree.key",
        "size": 300,
        "order": {
          "_key": "asc"
        },
        "include": ".*"
      },
      "meta": {
        "collapsed": true,
        "layout": "tree",
        "translateOnLoad": true,
        "orderByTranslation": true,
        "displayFilter": true,
        "filterByTranslation": true,
        "caseInsensitiveInclude": true
      }
    },
    "th_httpinspireeceuropaeutheme-theme_tree.key": {
      "terms": {
        "field": "th_httpinspireeceuropaeutheme-theme_tree.key",
        "size": 34,
        "order": {
          "_key": "asc"
        }
      },
      "meta": {
        "collapsed": true,
        "translateOnLoad": true,
        "orderByTranslation": true,
        "decorator": {
          "type": "icon",
          "prefix": "iti-",
          "expression": "http://inspire.ec.europa.eu/theme/(.*)"
        }
      }
    },
    "OrgForResource": {
      "terms": {
        "field": "OrgForResource",
        "include": ".*",
        "size": 15
      },
      "meta": {
        "caseInsensitiveInclude": true,
        "collapsed": true
      }
    },
    "creationYearForResource": {
      "histogram": {
        "field": "creationYearForResource",
        "interval": 1,
        "min_doc_count": 1
      },
      "meta": {
        "layout": "bar",
        "collapsed": true
      }
    },
    "resourceType": {
      "terms": {
        "field": "resourceType",
        "size": 10,
        "exclude": "map/.*|publication-.*"
      },
      "meta": {
        "collapsed": false,
        "layout": "nightingale",
        "decorator": {
          "type": "icon",
          "map": {
            "dataset": "faSolidDatabase",
            "map": "faSolidMap",
            "featureCatalog": "faSolidTable",
            "document": "faSolidCopy",
            "service": "faSolidCloud",
            "series": "faSolidCopy",
            "nonGeographicDataset": "faSolidChartColumn",
            "publication": "faSolidBook"
          }
        }
      }
    },
    "availableInServices": {
      "filters": {
        "filters": {
          "availableInViewService": {
            "query_string": {
              "query": "+linkProtocol:/OGC:WMS|OGC:OWS-C|OGC Web Map Service|OGC:WMTS|ESRI:REST/"
            }
          },
          "availableInDownloadService": {
            "query_string": {
              "query": "+linkProtocol:/WWW:DOWNLOAD|WWW:DOWNLOAD.*|WWW:OPENDAP|WWW:FTP|OGC:WFS|OGC Web Feature Service|OGC:WCS|MYO:MOTU-SUB|FILE|COPYFILE|DB|KML/"
            }
          }
        }
      },
      "meta": {
        "collapsed": true
      }
    }
  }
}
