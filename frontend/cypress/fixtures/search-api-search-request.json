    },
    "resourceType": {
      "terms": {
        "field": "resourceType",
        "size": 10,
        "exclude": "map/.*"
      },
      "meta": {
        "collapsed": true,
        "decorator": {
          "type": "icon",
          "map": {
            "dataset": "faSolidDatabase",
            "map": "faSolidMap",
            "featureCatalog": "faSolidTable",
            "document": "faSolidCopy",
            "service": "faSolidCloud",
            "series": "faSolidCopy",
            "nonGeographicDataset": "faSolidChartColumn",
            "publication": "faSolidBook"
          }
        }
