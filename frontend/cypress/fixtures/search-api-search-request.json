    "resourceTitle*",
    "resourceType",
    "status*",
    "uuid",
    "valid",
    "link",
    "rating",
    "resourceAbstract*",
    "resourceCreditObject",
    "logo",
    "overview"
  ],
  "sort": [],
  "aggregations": {
    "groupPublishedId": {
      "terms": {
        "field": "groupPublishedId",
        "size": 300,
        "include": ".*",
        "exclude": "1"
      },
      "meta": {
        "field": "groupPublishedId",
        "orderByTranslation": true,
        "filterByTranslation": true,
