{
  "from": 0,
  "size": 20,
  "track_total_hits": true,
  "query": {
    "bool": {
      "must": [],
      "must_not": [],
      "should": [],
      "filter": [
        {
          "query_string": {
            "query": "+isTemplate:n"
          }
        }
      ]
    }
  },
  "_source": [
